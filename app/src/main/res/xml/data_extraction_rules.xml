<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same intent as backup_rules.xml: cloud-backup and device-to-device
     transfer carry reminders + settings, never WorkManager's queue. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="app_database" />
        <include domain="database" path="app_database-wal" />
        <include domain="database" path="app_database-shm" />
        <include domain="file" path="datastore/" />
        <exclude domain="database" path="androidx.work.workdb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="app_database" />
        <include domain="database" path="app_database-wal" />
        <include domain="database" path="app_database-shm" />
        <include domain="file" path="datastore/" />
        <exclude domain="database" path="androidx.work.workdb" />
    </device-transfer>
</data-extraction-rules>
